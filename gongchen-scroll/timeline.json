  "subtitles": [
    {
      "start": 5.05,
      "end": 7.75,
      "text": "一六三一年  大运河的南端"
    },
    {
      "start": 7.8,
      "end": 9.3,
      "text": "拱起了一座桥"
    },
    {
      "start": 11.5,
      "end": 13.5,
      "text": "相传  “拱宸”二字"
    },
    {
      "start": 13.55,
      "end": 15.8,
      "text": "是向帝王拱手相迎"
    },
    {
      "start": 17.05,
      "end": 20.35,
      "text": "后来  它迎过南来北往的漕船"
    },
    {
      "start": 24.35,
      "end": 26.2,
      "text": "迎过纱厂的汽笛"
    },
    {
      "start": 26.25,
      "end": 28.0,
      "text": "早出晚归的工人"
    },
    {
      "start": 30.65,
      "end": 33.0,
      "text": "迎过桥西一代代手艺人"
    },
    {
      "start": 35.85,
      "end": 38.65,
      "text": "如今  它迎着清晨散步的老人"
    },
    {
      "start": 38.7,
      "end": 40.6,
      "text": "骑车上班的年轻人"
    },
    {
      "start": 41.05,
      "end": 43.1,
      "text": "也迎着远道而来的你"
    },
    {
      "start": 48.05,
      "end": 51.2,
      "text": "四百年  它一直拱着手"
    }
  ],
