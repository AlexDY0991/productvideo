#!/usr/bin/env bash
# dreamina-canvas wrapper: JSON output, non-interactive, retry only on transport failures.
# Retries reuse the exact same args, so callers must pin --node-id/--update-id/--submit-id for writes.
# The CLI prints success envelopes to stdout and error envelopes to stderr; this wrapper prints both to stdout.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
out=$(mktemp)
for attempt in 1 2 3 4 5; do
  dreamina-canvas --format json --non-interactive "$@" >"$out" 2>&1
  code=$?
  if grep -qE '"code":"cli\.(download_)?transport_failed"' "$out"; then
    echo "[jm] transport failure, retry $attempt" >&2; sleep $((attempt * 3)); continue
  fi
  break
done
cat "$out"; rm -f "$out"
exit $code
